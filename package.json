{
  "name": "sistech-homepoint",
  "version": "1.0.0",
  "private": true,
  "description": "HOME POINT NAVI(홈포인트 네비): GitHub Pages 정적 프런트 + Supabase 백엔드",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env scripts/dev.mjs",
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "build": "node --env-file-if-exists=.env scripts/build.mjs",
    "users": "node --env-file-if-exists=.env scripts/create-users.mjs",
    "login-email": "node scripts/login-email.mjs",
    "test": "node --test",
    "test:sql": "bash supabase/tests/run.sh",
    "lint": "eslint .",
    "vendor": "node scripts/vendor.mjs"
  },
  "devDependencies": {
    "@supabase/supabase-js": "2.119.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "globals": "17.13.0"
  }
}
