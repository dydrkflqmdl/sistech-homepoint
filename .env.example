# 로컬 개발 서버 포트. 카카오 개발자 콘솔에 http://localhost:4100 이 등록되어 있으니 바꾸지 않는 것을 권장한다.
PORT=4100

# 카카오맵 JavaScript 키 (developers.kakao.com › 플랫폼 키 › Web 플랫폼). 비워 두면 지도가 뜨지 않는다.
KAKAO_JS_KEY=

# Supabase 프로젝트 URL (Supabase 대시보드 › Project Settings › API). 필수.
SUPABASE_URL=

# Supabase anon(공개) 키 (같은 화면의 anon public). 필수. service_role 키는 넣지 않는다.
SUPABASE_ANON_KEY=
