# 로컬 개발 서버 포트. 카카오 개발자 콘솔에 http://localhost:4100 이 등록되어 있으니 바꾸지 않는 것을 권장한다.
PORT=4100

# 카카오맵 JavaScript 키 (developers.kakao.com › 플랫폼 키 › Web 플랫폼). 비워 두면 지도가 뜨지 않는다.
KAKAO_JS_KEY=

# Supabase 프로젝트 URL (Supabase 대시보드 › Project Settings › API). 필수.
SUPABASE_URL=

# Supabase anon(공개) 키 (Project Settings › API Keys의 anon public 또는 sb_publishable_...). 필수.
# 이 값은 config.js로 브라우저에 그대로 나간다. service_role 키나 sb_secret_... 키를 넣으면 빌드가 멈춘다.
SUPABASE_ANON_KEY=

# Supabase service_role 키 (Project Settings › API Keys). 비상용 스크립트(npm run users: 계정 생성·비밀번호 재설정·관리자 지정)에서만 쓴다.
# 평소 계정 관리는 사이트의 "계정 관리" 화면(Edge Function)으로 하므로 보통은 비워 둔다.
# 브라우저·config.js·GitHub Secrets에는 절대 넣지 않는다. 쓸 때만 넣고 끝나면 값을 비운다.
SUPABASE_SERVICE_ROLE_KEY=

# (선택) npm run users가 쓸 비밀번호. 비워 두면 실행할 때 화면에서 묻는다(권장).
# 명령줄 인자(--password)로는 받지 않는다. 넣었다면 다 쓰고 바로 지운다.
# 규칙: 6자 이상 72자 이하(문자 조건 없음).
USERS_PASSWORD=
