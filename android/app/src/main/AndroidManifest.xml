<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 현위치: 사이트의 [현위치]를 눌렀을 때만 묻는다(시작할 때 묻지 않음). 안드로이드 12+는 정확한 위치를 요청하려면 둘 다 선언해야 하고,
         사용자가 대략적인 위치만 허용해도 된다. 백그라운드 위치는 쓰지 않는다. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- 위치 장치가 없는 기기에도 설치되게 한다(현위치는 덤 기능). -->
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <!-- 로그인 정보(WebView 저장소)가 클라우드 백업·기기 이전으로 옮겨지지 않게 백업을 끈다. -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.HomePoint">

        <!-- 화면을 돌리거나 키보드·글자 크기·화면 배율·언어가 바뀌어도 화면을 다시 만들지 않는다(쓰던 메모·미션 기록이 날아가지 않게).
             singleTask: 어디서 열든 앱 화면(WebView)은 하나만 둔다. 두 개가 겹치면 뒤쪽 화면의 메모가 저장 안 된 채 남을 수 있다. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|fontScale|density|locale|layoutDirection"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
